{
  "name": "levi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "tsx tools/dev.ts",
    "build": "tsc -p tsconfig.build.json && vite build",
    "start": "node dist/local.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "format": "prettier --write src web tools test e2e '*.json' '*.ts' README.md docs",
    "format:check": "prettier --check src web tools test e2e '*.json' '*.ts' README.md docs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx tools/migrate.ts",
    "test": "tsx --test test/contracts.test.ts test/web.test.ts",
    "test:integration": "tsx tools/test-integration.ts",
    "dev:api": "tsx src/local.ts",
    "dev:web": "vite",
    "test:e2e": "tsx tools/test-integration.ts --browser"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@t00ls-dev/access": "0.1.2",
    "@t00ls-dev/audit": "1.0.0",
    "@t00ls-dev/auth": "0.3.0",
    "@t00ls-dev/db": "1.0.0",
    "@t00ls-dev/security": "0.2.0",
    "@t00ls-dev/tenant": "1.0.0",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "prettier": "3.9.9",
    "tsx": "4.20.5",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  },
  "overrides": {
    "playwright-core": "1.64.0"
  }
}
