{
  "name": "levi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "tsx src/local.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/local.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tools test '*.json' drizzle.config.ts README.md docs",
    "format:check": "prettier --check src tools test '*.json' drizzle.config.ts README.md docs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx tools/migrate.ts",
    "test": "tsx --test test/contracts.test.ts",
    "test:integration": "tsx tools/test-integration.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@t00ls-dev/access": "0.1.2",
    "@t00ls-dev/audit": "1.0.0",
    "@t00ls-dev/auth": "0.3.0",
    "@t00ls-dev/db": "1.0.0",
    "@t00ls-dev/security": "0.2.0",
    "@t00ls-dev/tenant": "1.0.0",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "prettier": "3.9.9",
    "tsx": "4.20.5",
    "typescript": "6.0.3"
  }
}
