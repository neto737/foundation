{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "instructions": [".agents/README.md"],
  "agent": {
    "build": {
      "model": "openai/gpt-6.1-sol",
      "mode": "primary",
      "description": "Build, compilation, and deployment tasks",
      "color": "success"
    },
    "plan": {
      "model": "openai/gpt-6.1-sol",
      "mode": "primary",
      "description": "Planning, analysis, and architectural decisions",
      "color": "primary"
    },
    "explore": {
      "model": "openai/gpt-6-luna",
      "mode": "subagent",
      "description": "Code exploration, search, and discovery",
      "color": "info"
    }
  }
}
